# 서버 포트
PORT=4000

# 프론트엔드 개발 서버 주소 (CORS 허용용)
CLIENT_ORIGIN=http://localhost:5173

# Prisma / SQLite DB 파일 경로
DATABASE_URL="file:./dev.db"

# 세션 시크릿 (반드시 임의의 긴 문자열로 교체할 것)
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8

# 최초 실행 시 자동 생성되는 관리자 계정
ADMIN_NAME=관리자
ADMIN_INITIAL_PIN=0000

# 로그인 실패 잠금 정책
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# 이메일 인증 로그인용 메일 발송 (SMTP). 비워 두면 개발 환경에서는 서버 콘솔에 인증 코드를 출력하고,
# 운영(NODE_ENV=production)에서는 이메일 로그인·등록이 503으로 막힌다.
# 예) Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=앱 비밀번호
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DutyCal <noreply@dsm.hs.kr>"

# 월초 자동 백업 보관 개수 (매달 1일 전월 기준 백업을 DB 폴더의 backups/monthly 에 생성)
AUTO_BACKUP_KEEP=24

# ---- Docker 배포용 (docker compose) ----
# 서버에서 접속할 포트 (http://서버주소:8080)
DUTYCAL_PORT=8080
# HTTPS로 서비스하면 true (http로 접속하면 로그인이 안 되므로 반드시 false 유지)
COOKIE_SECURE=false
# nginx 등 리버스 프록시 뒤에서 HTTPS를 처리하면 1로 설정 (COOKIE_SECURE=true와 함께)
# TRUST_PROXY=1
