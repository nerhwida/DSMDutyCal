# 서버 포트
PORT=4000

# 프론트엔드 개발 서버 주소 (CORS 허용용)
CLIENT_ORIGIN=http://localhost:5173

# Prisma / SQLite DB 파일 경로
DATABASE_URL="file:./dev.db"

# 세션 시크릿 (반드시 임의의 긴 문자열로 교체할 것)
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8

# 최초 실행 시 자동 생성되는 관리자 계정
ADMIN_NAME=관리자
ADMIN_INITIAL_PIN=0000

# 로그인 실패 잠금 정책
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Google 계정 로그인 (GCP OAuth 웹 클라이언트, 사용자 유형 Internal). 셋 중 하나라도 비우면 Google 로그인이 꺼진다.
# GCP에서 받은 JSON의 web.client_id / web.client_secret 값을 넣는다 (JSON 파일 자체는 저장소에 두지 말 것).
# GOOGLE_REDIRECT_URI는 GCP '승인된 리디렉션 URI'와 글자 하나까지 같아야 한다.
#   개발 PC에서 시험하려면 GCP에 http://localhost:5173/api/auth/google/callback 도 추가하고 아래 값을 그것으로 바꾼다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dutycal.dsmhs.kr/api/auth/google/callback

# 개인정보 수집 동의·Google 계정 연결 필수 여부 (기본 true). Google 로그인 장애 등 비상시에만 false로 끈다.
EMAIL_CONSENT_REQUIRED=true

# 월초 자동 백업 보관 개수 (매달 1일 전월 기준 백업을 DB 폴더의 backups/monthly 에 생성)
AUTO_BACKUP_KEEP=24

# ---- Docker 배포용 (docker compose) ----
# 서버에서 접속할 포트 (http://서버주소:8080)
DUTYCAL_PORT=8080
# HTTPS로 서비스하면 true (http로 접속하면 로그인이 안 되므로 반드시 false 유지)
COOKIE_SECURE=false
# nginx 등 리버스 프록시 뒤에서 HTTPS를 처리하면 1로 설정 (COOKIE_SECURE=true와 함께)
# TRUST_PROXY=1
